echo -e "${RED}${BOLD}╚══════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${YELLOW}  This package conflicts with the ArchTitan session stack.${NC}"
echo ""
echo -e "${CYAN}  ArchTitan OS exclusively supports:${NC}"
echo -e "    • ${BOLD}Compositor:${NC}       Hyprland (Wayland)"
echo -e "    • ${BOLD}Display Manager:${NC}  SDDM (with ArchTitan theme)"
echo -e "    • ${BOLD}HWM Dependency:${NC}   Titan Hardware Manager requires"
echo -e "                      Hyprland IPC — other compositors"
echo -e "                      will break profile-based RAM allocation."
echo ""
echo -e "${YELLOW}  Installing an alternative DM, DE, or X11 server is not${NC}"
echo -e "${YELLOW}  supported and will leave the system in a broken state.${NC}"
echo ""
echo -e "${RED}  Transaction aborted.${NC}"
echo ""
exit 1
