[Unit]
Description=Titan Hardware Manager (ArchTitan Daemon)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/titan_hw_manager
Restart=always
RestartSec=3

# The daemon needs to manage memory and kill processes.
# Running as root is typically required to access all /proc info and kill system-wide processes like Docker.
User=root
Group=root

[Install]
WantedBy=multi-user.target
