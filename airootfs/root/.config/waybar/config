{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "exclusive": true,

    "modules-left": [
        "custom/logo"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "custom/separator-center",
        "custom/hud-context",
        "custom/separator-app",
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "custom/gpu",
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "tray"
    ],

    "custom/logo": {
        "format": "◈ ARCHTITAN",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        },
        "format-icons": {
            "1": "01",
            "2": "02",
            "3": "03",
            "4": "04",
            "5": "05",
            "6": "06",
            "7": "07",
            "8": "08",
            "9": "09"
        }
    },

    "custom/separator-center": {
        "format": "│",
        "tooltip": false
    },

    "custom/hud-context": {
        "exec": "titan-hud-context",
        "interval": 1,
        "return-type": "json",
        "tooltip": true
    },

    "custom/separator-app": {
        "format": "·",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 36,
        "separate-outputs": true,
        "rewrite": {
            "^$": "",
            "(.*) - kitty": "Kitty",
            "^kitty$": "Kitty",
            "(.*) - fish": "Kitty",
            "(.*)Visual Studio Code(.*)": "Visual Studio Code",
            "(.*)Code - OSS(.*)": "Visual Studio Code",
            "^code$": "Visual Studio Code",
            "^code-oss$": "Visual Studio Code",
            "(.*)Android Studio(.*)": "Android Studio",
            "^android-studio$": "Android Studio",
            "(.*) — Brave": "Brave",
            "^brave-browser$": "Brave",
            "(.*) — Mozilla Firefox": "Firefox",
            "^firefox$": "Firefox",
            "(.*) — Chromium": "Chromium",
            "^chromium$": "Chromium",
            "(.*) — Falkon": "Titan Browser",
            "(.*) — Titan Browser": "Titan Browser",
            "^falkon$": "Titan Browser",
            "^titan-browser$": "Titan Browser",
            "(.*)calamares(.*)": "ArchTitan Setup",
            "(.*)Calamares(.*)": "ArchTitan Setup",
            "(.*)archtitan-settings(.*)": "ArchTitan Settings",
            "^pavucontrol$": "Volume Mixer",
            "^btop$": "System Monitor",
            "^ranger$": "Files",
            "^thunar$": "Files",
            "^nemo$": "Files",
            "^Spotify(.*)": "Spotify",
            "^vlc$": "VLC Media Player",
            "^mpv$": "MPV Player"
        }
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 3,
        "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)\nSwap: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB"
    },

    "custom/gpu": {
        "exec": "titan-hud-gpu",
        "interval": 3,
        "return-type": "json",
        "tooltip": true
    },

    "network": {
        "format-wifi": "NET {bandwidthDownBytes}",
        "format-ethernet": "NET {bandwidthDownBytes}",
        "format-disconnected": "NET OFF",
        "interval": 2,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTED",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-plugged": "PWR {capacity}%",
        "format-full": "BAT 100%",
        "format-not-found": "",
        "interval": 5,
        "tooltip-format": "{timeTo} — {capacity}%\nPower: {power:.1f}W"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#CDD6F4'><b>{}</b></span>",
                "days":     "<span color='#A6ADC8'>{}</span>",
                "weeks":    "<span color='#585B70'><b>W{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "today":    "<span color='#74C7EC'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 13,
        "spacing": 8,
        "show-passive-items": true
    }
}
