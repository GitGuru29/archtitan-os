# Titan Hardware Manager Configuration
# Architecture: cgroup v2 policy engine with PSI-driven escalation
#
# Escalation ladder (PSI-driven, not hardcoded RAM %):
#   Level 0 — PSI <  5% : deprioritize (cpu.weight=20, background slice)
#   Level 1 — PSI  5-20%: throttle memory.high (kernel reclaims)
#   Level 2 — PSI 20-40%: cgroup freeze (cgroup.freeze=1)
#   Level 3 — PSI > 40% : emergency SIGKILL (last resort only)
# RAM % thresholds are kept as fallback for kernels without PSI.

debounce_ms = 800
ram_freeze_pct = 50
ram_kill_pct = 25
thermal_hot_temp = 80

# PSI thresholds — some_avg10 % from /proc/pressure/memory
# Tune these up if you want HWM to be less aggressive
psi_deprioritize  = 5
psi_throttle      = 20
psi_freeze        = 40

# OOM scores — range: -1000 to +1000
# -200 = protected (kernel avoids killing, but not immune)
# +300 = expendable (kernel prefers killing these in OOM)
# Avoid -500 or below — process becomes effectively OOM-immune
oom_protect_score = -200
oom_expose_score  = 300

# Grace period between SIGTERM and SIGKILL (milliseconds)
# Electron apps (VS Code, Figma) need 500ms+ to save state
sigterm_grace_ms = 500

casual_workspaces  = 1
web_workspaces     = 2
android_workspaces = 3
system_workspaces  = 4, 5

web_extra_tools    =
android_extra_tools=
system_extra_tools =
