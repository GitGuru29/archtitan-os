#!/usr/bin/env bash
# titan-wallpaper-picker — ArchTitan wallpaper selector (Super+\ / Super+|)
#
# Scans /usr/share/backgrounds/archtitan/ and ~/.local/share/backgrounds/ for
# image files, presents them in Rofi as a large thumbnail grid, then calls
# titan-set-wallpaper to apply and persist the selection.
#
# Dependencies: rofi (2.0+), titan-set-wallpaper, notify-send (optional)

set -euo pipefail

# ── Wallpaper search paths ──────────────────────────────────────────────────
SYSTEM_DIR="/usr/share/backgrounds/archtitan"
USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backgrounds"

# ── Build candidate list ────────────────────────────────────────────────────
mapfile -t CANDIDATES < <(
    find "$SYSTEM_DIR" "${USER_DIR}" -maxdepth 2 \
        \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \
           -o -iname "*.webp" -o -iname "*.gif" \) \
        -type f 2>/dev/null | sort -u
)

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
    notify-send -u normal -i dialog-warning \
        "Wallpaper Picker" "No wallpapers found in:\n${SYSTEM_DIR}\n${USER_DIR}" 2>/dev/null || true
    exit 0
fi

# ── Build Rofi display list ─────────────────────────────────────────────────
# Row format, as parsed by rofi's dmenu row-option parser:
#     <label>\0icon\x1f<absolute-path>\n
# The \0 ends the visible label; the key/value pairs after it become row
# options, and "icon" is what makes rofi render the thumbnail (absolute paths
# are loaded directly as images, so -icon-theme is not wanted here).
#
# These bytes MUST be emitted by printf rather than accumulated in a variable:
# bash cannot store a NUL byte in a variable, so building the list with $'\0'
# silently yields "<label>icon\x1f<path>", which rofi reads as one long label
# with no icon at all — i.e. blank thumbnails and a label that never matches.
# Streaming through printf keeps the NUL on the pipe.
declare -A PATH_MAP   # label -> full path (for Enter resolution)
LABELS=()

for path in "${CANDIDATES[@]}"; do
    label="$(basename "${path%.*}")"
    # Guard against duplicate basenames by appending parent dir suffix
    if [[ -v "PATH_MAP[$label]" ]]; then
        parent="$(basename "$(dirname "$path")")"
        label="${parent}/${label}"
    fi
    PATH_MAP["$label"]="$path"
    LABELS+=("$label")
done

emit_rows() {
    local label
    for label in "${LABELS[@]}"; do
        printf '%s\0icon\x1f%s\n' "$label" "${PATH_MAP[$label]}"
    done
}

# ── Launch Rofi ─────────────────────────────────────────────────────────────
CHOSEN=$(
    emit_rows | \
    rofi -dmenu \
        -i \
        -p "  Wallpaper" \
        -theme /usr/share/rofi/themes/archtitan-wallpaper.rasi \
        -show-icons \
        2>/dev/null
) || true

[[ -z "$CHOSEN" ]] && exit 0   # user cancelled / Esc

# ── Resolve full path from chosen label ────────────────────────────────────
WALLPAPER_PATH="${PATH_MAP[$CHOSEN]:-}"

# Fallback: trim whitespace and retry
if [[ -z "$WALLPAPER_PATH" ]]; then
    CHOSEN_TRIM="${CHOSEN#"${CHOSEN%%[![:space:]]*}"}"
    CHOSEN_TRIM="${CHOSEN_TRIM%"${CHOSEN_TRIM##*[![:space:]]}"}"
    WALLPAPER_PATH="${PATH_MAP[$CHOSEN_TRIM]:-}"
fi

if [[ -z "$WALLPAPER_PATH" || ! -f "$WALLPAPER_PATH" ]]; then
    notify-send -u normal -i dialog-error \
        "Wallpaper Picker" "Could not resolve path for: $CHOSEN" 2>/dev/null || true
    exit 1
fi

# ── Apply the wallpaper ─────────────────────────────────────────────────────
exec titan-set-wallpaper "$WALLPAPER_PATH"
