#!/usr/bin/env bash
# titan-powermenu — Rofi-based power menu for ArchTitan OS
# Options: Lock, Sleep, Logout, Reboot, Shutdown

LOCK="󰌾  Lock"
SLEEP="󰒲  Sleep"
LOGOUT="󰍃  Logout"
REBOOT="󰑓  Reboot"
SHUTDOWN="󰐥  Shutdown"

# Determine which theme to use (local test or live system)
THEME="/usr/share/rofi/themes/archtitan-powermenu.rasi"
if [ ! -f "$THEME" ]; then
    # Fallback for local testing before ISO install
    THEME="$HOME/.config/rofi/archtitan-powermenu.rasi"
fi

CHOSEN=$(printf '%s\n' "$LOCK" "$SLEEP" "$LOGOUT" "$REBOOT" "$SHUTDOWN" | rofi \
    -dmenu \
    -i \
    -p "  Power" \
    -theme "$THEME")

case "$CHOSEN" in
    "$LOCK")
        if [ -d /run/archiso ]; then exit 0; fi
        loginctl lock-session
        ;;
    "$SLEEP")
        systemctl suspend
        ;;
    "$LOGOUT")
        hyprctl dispatch exit 0
        ;;
    "$REBOOT")
        systemctl reboot
        ;;
    "$SHUTDOWN")
        systemctl poweroff
        ;;
esac
