#!/usr/bin/env bash
# titan-hwm-waybar — Waybar JSON output for the Titan HWM module
# Reads /tmp/titan_hwm_state written by the daemon every transition.
# Returns: { "text", "class", "tooltip" } for Waybar custom module.

STATE="/tmp/titan_hwm_state"

if [[ ! -f "$STATE" ]]; then
    echo '{"text":"⚙ HWM","class":"inactive","tooltip":"Titan HWM not running"}'
    exit 0
fi

profile=$(grep "^profile="         "$STATE" | cut -d= -f2)
mem_pct=$(grep "^mem_available_pct=" "$STATE" | cut -d= -f2)
action=$(grep  "^last_action="     "$STATE" | cut -d= -f2)
freed=$(grep   "^freed_mb="        "$STATE" | cut -d= -f2)
temp=$(grep    "^cpu_temp_c="      "$STATE" | cut -d= -f2)
psi=$(grep     "^psi_some_avg10="  "$STATE" | cut -d= -f2)

# Trim to 1 decimal for PSI display
psi_display=$(printf "%.1f" "${psi:-0}")

case "$profile" in
    "Web Dev")     icon="🌐"; css_class="web"     ;;
    "Android Dev") icon="🤖"; css_class="android" ;;
    "System Dev")  icon="⚙️";  css_class="system"  ;;
    "Casual")      icon="🪑"; css_class="casual"  ;;
    "Neutral")     icon="💤"; css_class="neutral" ;;
    *)             icon="⚙";  css_class="inactive";;
esac

text="${icon} ${profile}"

tooltip="Profile: ${profile}\\nRAM Free: ${mem_pct}%\\nPSI: ${psi_display}%\\nAction: ${action}\\nFreed: ${freed}MB\\nCPU Temp: ${temp}°C"

echo "{\"text\":\"${text}\",\"class\":\"${css_class}\",\"tooltip\":\"${tooltip}\"}"
