#!/bin/bash
# launch-installer — Robust launcher for Calamares on ArchTitan Live ISO

# 1. Allow root to connect to XWayland / X11 server
if command -v xhost >/dev/null 2>&1; then
    xhost +SI:localuser:root >/dev/null 2>&1 || true
    xhost + >/dev/null 2>&1 || true
fi

# 2. Relax permissions on live user's runtime directory for root Qt Wayland access
if [[ -n "$XDG_RUNTIME_DIR" ]]; then
    chmod 777 "$XDG_RUNTIME_DIR" 2>/dev/null || true
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        chmod 777 "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" 2>/dev/null || true
    fi
fi

# 3. Export display & desktop environment variables
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export DISPLAY="${DISPLAY:-:0}"
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# 4. Launch Calamares in debug mode with logging
exec sudo -E calamares -d "$@" > /tmp/calamares.log 2>&1
