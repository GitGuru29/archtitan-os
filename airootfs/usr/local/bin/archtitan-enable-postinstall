#!/usr/bin/env bash
# archtitan-enable-postinstall
# Called by Calamares shellprocess module on the installed target system.
# 1. Ensures /etc/archtitan-postinstall/selections default flag file exists.
# 2. Enables archtitan-postinstall@<username>.service for the real installed user.

set -e

mkdir -p /etc/archtitan-postinstall

if [ ! -f /etc/archtitan-postinstall/selections ]; then
    cat > /etc/archtitan-postinstall/selections << 'EOF'
# Generated by Calamares shellprocess — DO NOT EDIT
# Controls archtitan-postinstall first-boot service
INSTALL_AGY=false
INSTALL_CLAUDE_CODE=false
INSTALL_CODEX=false
INSTALL_AIDER=false
INSTALL_CONTINUE_DEV=false
INSTALL_OLLAMA=false
INSTALL_ANDROID_STUDIO=false
INSTALL_FLUTTER=false
INSTALL_HEROIC=false
INSTALL_PROTON_GE=false
INSTALL_GCLOUD=false
INSTALL_AZURE_CLI=false
INSTALL_BURPSUITE=false
INSTALL_METASPLOIT=false
INSTALL_PYTORCH=false
INSTALL_TENSORFLOW=false
INSTALL_HF_TRANSFORMERS=false
INSTALL_SLACK=false
INSTALL_ZOOM=false
INSTALL_TEAMS=false
INSTALL_FIGMA=false
INSTALL_DAVINCI=false
INSTALL_RUST_CROSS=false
EOF
    chmod 644 /etc/archtitan-postinstall/selections
fi

REAL_USER=$(awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }' /etc/passwd)
if [[ -n "$REAL_USER" ]]; then
    systemctl enable "archtitan-postinstall@${REAL_USER}.service" || true
    echo "[archtitan] Enabled postinstall service for user: $REAL_USER"
fi
