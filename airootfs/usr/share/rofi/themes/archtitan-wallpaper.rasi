/* ═══════════════════════════════════════════════════════════
 * ArchTitan Wallpaper Picker — Modern Grid Thumbnail Layout
 * Catppuccin Mocha · glassmorphism card · 4-col thumbnail grid
 * ═══════════════════════════════════════════════════════════ */

* {
    crust:    #11111b;
    mantle:   #181825;
    base:     #1e1e2e;
    surface0: #313244;
    surface1: #45475a;
    overlay0: #6c7086;
    overlay1: #7f849c;
    text:     #cdd6f4;
    subtext0: #a6adc8;
    subtext1: #bac2de;
    lavender: #b4befe;
    blue:     #89b4fa;
    mauve:    #cba6f7;
    peach:    #fab387;
    green:    #a6e3a1;

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 12";
}

/* ── Window ─────────────────────────────────────────────── */
window {
    width:            960px;
    border-radius:    20px;
    border:           1px solid;
    border-color:     #b4befe2e;
    background-color: #11111beb;
    padding:          24px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    spacing:          16px;
    children:         [ inputbar, listview ];
}

/* ── Search bar ─────────────────────────────────────────── */
inputbar {
    background-color: #31324499;
    border-radius:    12px;
    border:           1px solid;
    border-color:     #b4befe1f;
    padding:          10px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @lavender;
    font:             "JetBrainsMono Nerd Font Bold 14";
    vertical-align:   0.5;
    padding:          0 0 0 2px;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Search wallpapers…";
    placeholder-color: @overlay0;
    vertical-align:    0.5;
}

case-indicator {
    background-color: transparent;
    text-color:       transparent;
}

/* ── Thumbnail grid ─────────────────────────────────────── */
listview {
    background-color: transparent;
    layout:           vertical;
    scrollbar:        false;
    lines:            2;
    columns:          4;
    spacing:          12px;
    fixed-height:     false;
    dynamic:          true;
}

/* ── Each wallpaper card ────────────────────────────────── */
element {
    background-color: #31324473;
    border-radius:    14px;
    border:           1px solid;
    border-color:     #ffffff0d;
    padding:          10px;
    spacing:          0px;
    orientation:      vertical;
    cursor:           pointer;
    children:         [ element-icon, element-text ];
}

element-icon {
    size:             160px;
    border-radius:    10px;
    background-color: @surface0;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       @subtext0;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          8px 4px 2px 4px;
    font:             "JetBrainsMono Nerd Font 10";
    cursor:           inherit;
}

/* ── States ─────────────────────────────────────────────── */
element normal.normal {
    background-color: #31324473;
    border-color:     #ffffff0d;
}

element alternate.normal {
    background-color: #31324473;
    border-color:     #ffffff0d;
}

element selected.normal {
    background-color: #89b4fa24;
    border:           1px solid;
    border-color:     @blue;
}

element selected.normal element-text {
    text-color: @lavender;
    font:       "JetBrainsMono Nerd Font Bold 10";
}

/* ── Scrollbar (fallback if enabled) ───────────────────── */
scrollbar {
    background-color: @surface0;
    handle-color:     @overlay0;
    handle-width:     4px;
    border-radius:    4px;
}
