/* ═══════════════════════════════════════════════════════════
 * ArchTitan Wallpaper Picker — Modern Grid Thumbnail Layout
 * Catppuccin Mocha · glassmorphism card · 4-col thumbnail grid
 * ═══════════════════════════════════════════════════════════ */

* {
    crust:    #11111b;
    mantle:   #181825;
    base:     #1e1e2e;
    surface0: #313244;
    surface1: #45475a;
    overlay0: #6c7086;
    overlay1: #7f849c;
    text:     #cdd6f4;
    subtext0: #a6adc8;
    subtext1: #bac2de;
    lavender: #b4befe;
    blue:     #89b4fa;
    mauve:    #cba6f7;
    peach:    #fab387;
    green:    #a6e3a1;

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 12";
}

/* ── Window ─────────────────────────────────────────────── */
window {
    width:            960px;
    border-radius:    20px;
    border:           1px solid rgba(180,190,254,0.18);
    background-color: rgba(17,17,27,0.92);
    padding:          24px;
    location:         center;
    anchor:           center;
    box-shadow:       0 24px 64px rgba(0,0,0,0.75);
}

mainbox {
    background-color: transparent;
    spacing:          16px;
    children:         [ header-box, inputbar, listview ];
}

/* ── Header label row ───────────────────────────────────── */
header-box {
    background-color: transparent;
    orientation:      horizontal;
    spacing:          10px;
    children:         [ prompt ];
}

prompt {
    background-color: transparent;
    text-color:       @lavender;
    font:             "JetBrainsMono Nerd Font Bold 14";
    vertical-align:   0.5;
    padding:          0 0 0 2px;
}

/* ── Search bar ─────────────────────────────────────────── */
inputbar {
    background-color: rgba(49,50,68,0.6);
    border-radius:    12px;
    border:           1px solid rgba(180,190,254,0.12);
    padding:          10px 16px;
    spacing:          10px;
    children:         [ entry ];
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Search wallpapers…";
    placeholder-color: @overlay0;
    vertical-align:    0.5;
    cursor:            text;
}

/* hide the redundant case-indicator / num-rows pills */
case-indicator,
num-rows,
num-filtered-rows { background-color: transparent; text-color: transparent; }

/* ── Thumbnail grid ─────────────────────────────────────── */
listview {
    background-color: transparent;
    layout:           vertical;
    scrollbar:        false;
    lines:            2;
    columns:          4;
    spacing:          12px;
    fixed-height:     false;
    dynamic:          true;
}

/* ── Each wallpaper card ────────────────────────────────── */
element {
    background-color: rgba(49,50,68,0.45);
    border-radius:    14px;
    border:           1px solid rgba(255,255,255,0.05);
    padding:          10px;
    spacing:          0px;
    orientation:      vertical;
    cursor:           pointer;
    children:         [ element-icon, element-text ];
}

element-icon {
    size:             160px;
    border-radius:    10px;
    background-color: @surface0;
    cursor:           inherit;
    /* scale-filter: bilinear; */
}

element-text {
    background-color: transparent;
    text-color:       @subtext0;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          8px 4px 2px 4px;
    font:             "JetBrainsMono Nerd Font 10";
    cursor:           inherit;
    /* truncate long names */
    max-lines:        1;
}

/* ── States ─────────────────────────────────────────────── */
element normal.normal {
    background-color: rgba(49,50,68,0.45);
    border-color:     rgba(255,255,255,0.05);
}

element alternate.normal {
    background-color: rgba(49,50,68,0.45);
    border-color:     rgba(255,255,255,0.05);
}

element selected.normal {
    background-color: rgba(137,180,250,0.14);
    border-color:     @blue;
    border:           1px solid;
}

element selected.normal element-text {
    text-color: @lavender;
    font:       "JetBrainsMono Nerd Font Bold 10";
}

element normal.normal:hover,
element alternate.normal:hover {
    background-color: rgba(255,255,255,0.06);
    border-color:     rgba(180,190,254,0.2);
}

/* ── Scrollbar (fallback if enabled) ───────────────────── */
scrollbar {
    background-color: @surface0;
    handle-color:     @overlay0;
    handle-width:     4px;
    border-radius:    4px;
}
