/* ============================================================
 * ArchTitan OS — Spotlight Search Theme for Rofi
 * Inspired by macOS Spotlight: centered, frosted-glass, minimal
 * All colors use argb: hex (0xAARRGGBB) — universally supported
 * ============================================================ */

* {
    /* Color palette — argb:AARRGGBB format */
    /* bg-dark     rgba(18, 18, 28, 0.88)  → AA=E0 */
    bg-dark:        #E012121C;
    /* bg-selected rgba(122,162,247, 0.25) → AA=40 */
    bg-selected:    #407AA2F7;
    /* bg-hover    rgba(122,162,247, 0.12) → AA=1F */
    bg-hover:       #1F7AA2F7;
    /* border-col  rgba(122,162,247, 0.45) → AA=73 */
    border-accent:  #737AA2F7;
    /* border-subtle rgba(255,255,255,0.08)→ AA=14 */
    border-subtle:  #14FFFFFF;
    /* text colors — fully opaque */
    text-primary:   #DCDCEB;
    text-secondary: #96A0BE;
    text-accent:    #7AA2F7;
    text-dim:       #646991;
    scrollbar-clr:  #597AA2F7;

    /* Rofi resets */
    background-color:   transparent;
    text-color:         @text-primary;
    font:               "Inter 12";
    border:             0px solid;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

/* ── Root window ───────────────────────────────────────────── */
window {
    location:           center;
    anchor:             center;
    width:              640px;
    border-radius:      18px;
    background-color:   @bg-dark;
    border:             1px solid;
    border-color:       @border-accent;
}

/* ── Main layout ────────────────────────────────────────────── */
mainbox {
    background-color:   transparent;
    children:           [ inputbar, message, listview ];
    padding:            0px;
    spacing:            0px;
}

/* ── Search bar ─────────────────────────────────────────────── */
inputbar {
    background-color:   transparent;
    padding:            22px 20px 18px 20px;
    spacing:            12px;
    children:           [ prompt, entry ];
    border:             0px 0px 1px 0px solid;
    border-color:       @border-subtle;
}

prompt {
    background-color:   transparent;
    text-color:         @text-accent;
    font:               "Inter Bold 13";
    padding:            2px 0px 0px 6px;
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @text-primary;
    placeholder-color:  @text-dim;
    placeholder:        "Search apps, files, commands…";
    font:               "Inter 14";
    padding:            0px;
    cursor:             text;
    vertical-align:     0.5;
}

/* ── Message ────────────────────────────────────────────────── */
message {
    background-color:   transparent;
    padding:            8px 24px 0px 24px;
}

textbox {
    text-color:         @text-secondary;
    font:               "Inter 11";
    background-color:   transparent;
}

/* ── Results list ───────────────────────────────────────────── */
listview {
    background-color:   transparent;
    padding:            10px 8px 10px 8px;
    spacing:            2px;
    lines:              8;
    columns:            1;
    scrollbar:          true;
    fixed-height:       false;
    dynamic:            true;
    cycle:              false;
}

/* ── Result row ─────────────────────────────────────────────── */
element {
    background-color:   transparent;
    padding:            10px 16px;
    border-radius:      10px;
    spacing:            12px;
    orientation:        horizontal;
    children:           [ element-icon, element-text ];
    cursor:             pointer;
}

element-icon {
    size:               28px;
    background-color:   transparent;
    vertical-align:     0.5;
    cursor:             inherit;
}

element-text {
    background-color:   transparent;
    text-color:         @text-primary;
    font:               "Inter 12";
    vertical-align:     0.5;
    cursor:             inherit;
    highlight:          bold @text-accent;
}

/* Selected */
element selected {
    background-color:   @bg-selected;
    border:             1px solid;
    border-color:       @border-accent;
}

element selected > element-text {
    text-color:         @text-primary;
}

/* ── Scrollbar ──────────────────────────────────────────────── */
scrollbar {
    width:              4px;
    handle-width:       4px;
    handle-color:       @scrollbar-clr;
    background-color:   transparent;
    border:             0px solid;
    margin:             4px 4px 4px 0px;
    border-radius:      4px;
}

/* ── Mode switcher ──────────────────────────────────────────── */
mode-switcher {
    background-color:   transparent;
    border:             1px 0px 0px 0px solid;
    border-color:       @border-subtle;
    padding:            8px 12px;
    spacing:            6px;
}

button {
    background-color:   transparent;
    text-color:         @text-dim;
    font:               "Inter 10";
    padding:            4px 10px;
    border-radius:      6px;
    cursor:             pointer;
}

button selected {
    background-color:   @bg-hover;
    text-color:         @text-accent;
}
