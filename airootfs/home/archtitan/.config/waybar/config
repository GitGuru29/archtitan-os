{
    "layer": "top",
    "position": "top",
    "height": 46,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "exclusive": true,

    "modules-left": [
        "custom/logo",
        "memory",
        "network",
        "cpu",
        "mpris"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/titan-hwm",
        "battery",
        "clock",
        "tray",
        "bluetooth"
    ],

    "custom/logo": {
        "format": "✦  ARCHTITAN",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "mpris": {
        "format": "{player_icon}  {title} — {artist}",
        "format-paused": "{status_icon}  {title}",
        "format-stopped": "♪  No media",
        "player-icons": {
            "default": "▶",
            "spotify": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": ["firefox"],
        "max-length": 30,
        "tooltip": false
    },

    "memory": {
        "format": "  {}%",
        "tooltip-format": "RAM: {used:0.1f} GB / {total:0.1f} GB\nSwap: {swapUsed:0.1f} GB / {swapTotal:0.1f} GB",
        "interval": 5
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀  Wired",
        "format-disconnected": "󰤭  Off",
        "tooltip-format-wifi": "{essid} — {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true,
        "interval": 2
    },

    "custom/titan-hwm": {
        "exec": "bash -c 'if [ -d /run/archiso ]; then echo \"{\\\"text\\\":\\\"⬇ Live Mode\\\",\\\"tooltip\\\":\\\"ArchTitan Live ISO — HWM inactive\\\",\\\"class\\\":\\\"live\\\"}\"; else titan-hwm-waybar; fi'",
        "interval": 5,
        "return-type": "json",
        "on-click": "bash -c 'if [ ! -d /run/archiso ]; then titan-hwm status; fi'",
        "on-right-click": "bash -c 'if [ ! -d /run/archiso ]; then kitty --title=\"Titan HWM\" -e bash -c \"titan-hwm status; echo; read -p \\\"Press Enter...\\\"\"; fi'"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "  Full",
        "format-not-found": "󰂑  AC",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo} — {capacity}%\nPower: {power:.1f}W",
        "interval": 5
    },

    "clock": {
        "format": "{:%H:%M\n%a, %d/%m}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#C0CAF5'><b>{}</b></span>",
                "days":     "<span color='#A9B1D6'>{}</span>",
                "weeks":    "<span color='#565F89'><b>W{}</b></span>",
                "weekdays": "<span color='#7AA2F7'><b>{}</b></span>",
                "today":    "<span color='#00D4FF'><b><u>{}</u></b></span>"
            }
        }
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6,
        "show-passive-items": true
    }
}
