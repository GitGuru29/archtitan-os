{
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "exclusive": true,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/mediahub"
    ],

    "modules-right": [
        "custom/power-profile",
        "clock",
        "temperature",
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    "custom/logo": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "custom/mediahub": {
        "exec": "echo '{\"text\": \"● ○ ○ ○ ○ ○  MEDIA HUB  (AUTO SCROLLING)\", \"tooltip\": \"Click to toggle Titan Media Hub\"}'",
        "return-type": "json",
        "interval": 4,
        "on-click": "titan-media-hud --toggle",
        "on-scroll-up": "titan-media-hud --prev",
        "on-scroll-down": "titan-media-hud --next",
        "tooltip": true
    },

    "custom/power-profile": {
        "exec": "powerprofilesctl get 2>/dev/null | sed 's/balanced/🌿 Balanced/;s/performance/⚡ Performance/;s/power-saver/🔋 Power Saver/' || echo '🌿 Balanced'",
        "interval": 5,
        "format": "{}",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "🌡 {temperatureC}°C",
        "format-critical": "🔥 {temperatureC}°C",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇 MUTED",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "interval": 5,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-full": "🔋 100%",
        "format-not-found": "",
        "interval": 5,
        "tooltip-format": "{timeTo} — {capacity}%\nPower: {power:.1f}W"
    },

    "clock": {
        "format": "📅 {:%a, %d %b\n%H:%M}",
        "format-alt": "📅 {:%A, %d %B %Y}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#CDD6F4'><b>{}</b></span>",
                "days":     "<span color='#A6ADC8'>{}</span>",
                "weeks":    "<span color='#585B70'><b>W{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "today":    "<span color='#74C7EC'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "show-passive-items": true
    }
}
