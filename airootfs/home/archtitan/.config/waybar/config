{
    "layer"        : "top",
    "position"     : "top",
    "height"       : 38,
    "margin-top"   : 6,
    "margin-left"  : 10,
    "margin-right" : 10,
    "spacing"      : 0,
    "exclusive"    : true,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/titan-center"
    ],

    "modules-right": [
        "custom/power-profile",
        "custom/separator",
        "clock",
        "custom/separator",
        "temperature",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "network",
        "custom/separator",
        "battery",
        "tray"
    ],

    // ── LEFT: Workspaces ───────────────────────────────────────

    "hyprland/workspaces": {
        "format"              : "{id}",
        "on-click"            : "activate",
        "sort-by-number"      : true,
        "persistent-workspaces": { "*": 5 }
    },

    // ── CENTER: Embedded Rolling Viewport ──────────────────────

    "custom/titan-center": {
        "exec"            : "titan-bar-daemon",
        "return-type"     : "json",
        "restart-interval": 5,
        "on-scroll-down"  : "titan-bar-next",
        "on-scroll-up"    : "titan-bar-prev",
        "on-click"        : "titan-bar-next",
        "on-click-right"  : "titan-bar-prev",
        "tooltip"         : true
    },

    // ── RIGHT: Telemetry ───────────────────────────────────────

    "custom/power-profile": {
        "exec"    : "powerprofilesctl get 2>/dev/null | sed 's/balanced/󰌪  Balanced/;s/performance/󰓅  Performance/;s/power-saver/󰚥  Saver/' || echo '󰌪  Balanced'",
        "interval": 10,
        "format"  : "{}",
        "tooltip" : false
    },

    "custom/separator": {
        "format" : "<span color='#1f202e'>│</span>",
        "tooltip": false
    },

    "clock": {
        "format"         : "󰸗  {:%a, %d %b · %H:%M}",
        "format-alt"     : "󰸗  {:%A, %d %B %Y · %H:%M:%S}",
        "tooltip-format" : "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode"      : "month",
            "weeks-pos" : "right",
            "on-scroll" : 1,
            "format": {
                "months"  : "<span color='#cdd6f4'><b>{}</b></span>",
                "days"    : "<span color='#7f849c'>{}</span>",
                "weeks"   : "<span color='#45475a'><b>W{}</b></span>",
                "weekdays": "<span color='#b4befe'><b>{}</b></span>",
                "today"   : "<span color='#a6e3a1'><b><u>{}</u></b></span>"
            }
        }
    },

    "temperature": {
        "critical-threshold": 80,
        "format"            : "󰔏  {temperatureC}°C",
        "format-critical"   : "󰔏  {temperatureC}°C",
        "interval"          : 3,
        "tooltip"           : false
    },

    "pulseaudio": {
        "format"        : "󰕾  {volume}%",
        "format-muted"  : "󰖁  Muted",
        "on-click"      : "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-right-click": "pavucontrol",
        "tooltip"       : false
    },

    "network": {
        "format-wifi"        : "󰤨",
        "format-ethernet"    : "󰈀",
        "format-disconnected": "󰤭",
        "interval"           : 5,
        "tooltip-format-wifi"    : "{essid} ({signalStrength}%)\nIP: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}"
    },

    "battery": {
        "states"          : { "good": 95, "warning": 30, "critical": 15 },
        "format"          : "󰁹  {capacity}%",
        "format-charging" : "󰂄  {capacity}%",
        "format-plugged"  : "󰚥  {capacity}%",
        "format-full"     : "󰁹  100%",
        "format-not-found": "",
        "interval"        : 10,
        "tooltip-format"  : "{timeTo} · {capacity}%\nPower: {power:.1f}W"
    },

    "tray": {
        "icon-size"        : 14,
        "spacing"          : 8,
        "show-passive-items": true
    }
}
